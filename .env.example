# Copy to .env and fill in. Never commit .env.
#
# DeepSeek (OpenAI-compatible) — see https://api-docs.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_MONTHLY_CEILING_USD=10

# Django
DJANGO_SECRET_KEY=change-me-generate-a-random-50-char-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
JOBMON_DATA_DIR=data

# Gmail OAuth: path to the Google Cloud OAuth client JSON you download.
# Place the file at this path (gitignored). See README "Gmail OAuth setup".
GOOGLE_OAUTH_CLIENT_SECRETS=credentials.json

# Display timezone (stored timestamps stay UTC).
DISPLAY_TIMEZONE=Africa/Cairo
GMAIL_DEFAULT_HISTORY_DAYS=90
